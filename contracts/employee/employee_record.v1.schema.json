{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bbtc://contracts/employee/employee_record.v1",
  "title": "Employee Record",
  "type": "object",
  "required": ["employee_id", "display_name", "role", "status", "created_at_utc", "updated_at_utc"],
  "properties": {
    "employee_id": {"type": "string", "minLength": 1},
    "display_name": {"type": "string", "minLength": 1},
    "role": {"enum": ["employee", "manager", "owner"]},
    "status": {"enum": ["active", "inactive", "removed"]},
    "hourly_rate": {"type": ["number", "null"], "minimum": 0},
    "tax_withholding_amount": {"type": ["number", "null"], "minimum": 0},
    "tax_withholding_percent": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
    "created_at_utc": {"type": "string", "format": "date-time"},
    "updated_at_utc": {"type": "string", "format": "date-time"},
    "removed_at_utc": {"type": ["string", "null"], "format": "date-time"}
  },
  "additionalProperties": true
}
