{
  "$id": "https://bestbuds.example/aos/timeclock/v0.5.0/backup_manifest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "backup_id": {
      "type": "string"
    },
    "created_at_utc": {
      "type": "string"
    },
    "data_tree_hash": {
      "type": "string"
    },
    "file_count": {
      "minimum": 0,
      "type": "integer"
    },
    "files": {
      "type": "array"
    },
    "non_claims": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "restore_policy": {
      "type": "object"
    },
    "source_ledger_hash": {
      "type": "string"
    },
    "version": {
      "type": "string"
    }
  },
  "required": [
    "backup_id",
    "version",
    "created_at_utc",
    "file_count",
    "files",
    "data_tree_hash",
    "source_ledger_hash",
    "restore_policy",
    "non_claims"
  ],
  "title": "Backup Manifest",
  "type": "object"
}
